# Makefile for {{ name }} (generated by scaffold)
.DEFAULT_GOAL := help

CC      ?= gcc
AR      ?= ar
CFLAGS  ?= -Wall -Wextra
LDFLAGS ?=

SRC_DIR     = src
INCLUDE_DIR = include
BUILD_DIR   = build
TEST_DIR    = tests
DEPS_DIR    = {{ deps_dir }}

LIB_NAME = {{ name }}
SO_NAME  = lib$(LIB_NAME).so
A_NAME   = lib$(LIB_NAME).a
VERSION  = {{ version }}

SRC = $(wildcard $(SRC_DIR)/*.c)
OBJ = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEP = $(OBJ:.o=.d)

TESTS = $(patsubst $(TEST_DIR)/%.c,$(BUILD_DIR)/%,$(wildcard $(TEST_DIR)/*.c))

CFLAGS += -I$(INCLUDE_DIR) -fPIC -MMD -MP
{% if deps %}
DEPS = {{ deps | join(' ') }}
DEPS_SCRIPTS_DIR = tools/deps
CFLAGS  += -I$(DEPS_DIR) {{ dep_cflags }}
LDFLAGS += {{ dep_ldflags }}
{% endif %}

# Profile: `make type=RELEASE` for an optimized build
ifeq ($(type), RELEASE)
	CFLAGS += -O3 -DNDEBUG
else
	SANITIZERS = -fsanitize=address,undefined
	CFLAGS  += -DDEBUG -ggdb $(SANITIZERS)
	LDFLAGS += $(SANITIZERS)
endif

.PHONY: all
all: static shared ## Build static and shared libraries

.PHONY: static
static: $(A_NAME) ## Build the static library

.PHONY: shared
shared: $(SO_NAME) ## Build the shared library

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(A_NAME): $(OBJ) | $(BUILD_DIR) ## Link the static library
	@echo "[INFO] Linking $@"
	$(AR) rcs $@ $(OBJ)

$(SO_NAME): $(OBJ) | $(BUILD_DIR) ## Link the shared library
	@echo "[INFO] Linking $@"
	$(CC) -shared $(OBJ) -o $@ $(LDFLAGS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR) ## Compile a source file
	@echo "[INFO] Compiling $<"
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/%: $(TEST_DIR)/%.c $(A_NAME) | $(BUILD_DIR) ## Compile a test binary
	@echo "[INFO] Compiling $<"
	$(CC) $(CFLAGS) -o $@ $< $(A_NAME) $(LDFLAGS)

.PHONY: test
test: $(TESTS) ## Build and run all tests
	@set -e; for t in $(TESTS); do \
		echo "[RUN] $$t"; \
		./$$t; \
	done

-include $(DEP)

{% if deps %}
.PHONY: fetch
fetch: ## Fetch all dependencies into $(DEPS_DIR)
	@set -e; for dep in $(DEPS); do \
		echo "[INFO] Fetching $$dep"; \
		bash $(DEPS_SCRIPTS_DIR)/$$dep/fetch $(DEPS_DIR); \
	done
{% endif %}

.PHONY: clean
clean: ## Remove all build files
	rm -rf $(BUILD_DIR)

.PHONY: help
help: ## Show this help message
	@echo "Available commands:"
	@grep -h -E '^[a-zA-Z0-9_.-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-25s\033[0m %s\n", $$1, $$2}'
