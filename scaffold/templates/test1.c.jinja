#include <assert.h>
#include <stdio.h>

#include "header1.h"
#include "header2.h"

static void test_add(void)
{
    assert(add(2, 3) == 5);
    assert(add(-1, 1) == 0);
}

static void test_mul(void)
{
    assert(mul(2, 3) == 6);
    assert(mul(-1, 3) == -3);
}

int main(void)
{
    test_add();
    test_mul();
    printf("All tests passed!\n");
    return 0;
}
