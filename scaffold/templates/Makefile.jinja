# Makefile for {{ name }} (generated by scaffold)
.DEFAULT_GOAL := help

CC      ?= gcc
CFLAGS  ?= -Wall -Wextra
LDFLAGS ?=

SRC_DIR     = src
INCLUDE_DIR = include
BUILD_DIR   = build
DIST_DIR    = dist
DEPS_DIR    = {{ deps_dir }}

TARGET = {{ name }}
VERSION = {{ version }}

SRC = $(wildcard $(SRC_DIR)/*.c)
OBJ = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEP = $(OBJ:.o=.d)

CFLAGS += -I$(INCLUDE_DIR) -MMD -MP
{% if deps %}
DEPS = {{ deps | join(' ') }}
DEPS_SCRIPTS_DIR = tools/deps
CFLAGS  += -I$(DEPS_DIR) {{ dep_cflags }}
LDFLAGS += {{ dep_ldflags }}
{% endif %}

# Profile: `make type=RELEASE` for an optimized build
ifeq ($(type), RELEASE)
	CFLAGS += -O3 -DNDEBUG
else
	SANITIZERS = -fsanitize=address,undefined
	CFLAGS  += -DDEBUG -ggdb $(SANITIZERS)
	LDFLAGS += $(SANITIZERS)
endif

.PHONY: all
all: $(TARGET) ## Build the project

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(TARGET): $(OBJ) | $(BUILD_DIR) ## Link the executable
	@echo "[INFO] Linking $@"
	$(CC) $(OBJ) -o $@ $(LDFLAGS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR) ## Compile a source file
	@echo "[INFO] Compiling $<"
	$(CC) $(CFLAGS) -c -o $@ $<

-include $(DEP)

{% if deps %}
.PHONY: fetch
fetch: ## Fetch all dependencies into $(DEPS_DIR)
	@set -e; for dep in $(DEPS); do \
		echo "[INFO] Fetching $$dep"; \
		bash $(DEPS_SCRIPTS_DIR)/$$dep/fetch $(DEPS_DIR); \
	done
{% endif %}

.PHONY: clean
clean: ## Remove all build files and the executable
	rm -rf $(BUILD_DIR) $(TARGET) $(DIST_DIR)

.PHONY: help
help: ## Show this help message
	@echo "Available commands:"
	@grep -h -E '^[a-zA-Z0-9_.-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-25s\033[0m %s\n", $$1, $$2}'
