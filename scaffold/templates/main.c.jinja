#include <stdio.h>
#include <stdlib.h>

#include "version.h"
#include "header1.h"
#include "header2.h"
{% if dep_cli %}
#define CLI_IMPLEMENTATION
#include "io/cli.h"
{% endif %}
{% if dep_logging %}
#define LOGGING_IMPLEMENTATION
#include "io/logging.h"
{% endif %}

int main(int argc, char** argv)
{
{% if dep_cli %}
    Dispatcher dispatcher = {0};
    dispatcher_init(&dispatcher);

    cli_args_t args = cli_args_make(
        cli_arg_new('h', "help", "Prints this message", no_argument),
        cli_arg_new('v', "version", "Prints the version and exits", no_argument),
        NULL
    );

    int opt;
    LOOP_ARGS(opt, args) {
        switch (opt) {
            case 'h':
                cli_help(args, &dispatcher, "{{ name }}", "Generated by scaffold");
                goto success;
            case 'v':
                printf("%s\n", VERSION_STRING);
                goto success;
            default:
                break;
        }
    }
{% endif %}
    printf("Hello from %s v%s!\n", "{{ name }}", VERSION_STRING);
    printf("add(2, 3) = %d\n", add(2, 3));
    printf("mul(2, 3) = %d\n", mul(2, 3));

{% if dep_cli %}
success:
    cli_args_free(&args);
{% endif %}
    return 0;
}
