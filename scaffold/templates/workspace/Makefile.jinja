# Makefile for {{ name }} (generated by scaffold, root orchestrator)
.DEFAULT_GOAL := help

CC      ?= gcc
CFLAGS  ?= -Wall -Wextra
LDFLAGS ?=

SRC_DIR     = src
INCLUDE_DIR = include
BUILD_DIR   = build
TEST_DIR    = tests
APPS_DIR    = apps
LIBS_DIR    = libs
DEPS_DIR    = {{ deps_dir }}

TARGET  = {{ name }}
VERSION = {{ version }}

SRC = $(wildcard $(SRC_DIR)/*.c)
OBJ = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEP = $(OBJ:.o=.d)

APPS     = $(notdir $(wildcard $(APPS_DIR)/*))
LIBS     = $(notdir $(wildcard $(LIBS_DIR)/*))
LIB_ARCH = $(foreach lib,$(LIBS),$(LIBS_DIR)/$(lib)/lib$(lib).a)

CFLAGS += -I$(INCLUDE_DIR) $(foreach lib,$(LIBS),-I$(LIBS_DIR)/$(lib)/include) -MMD -MP
{% if deps %}
DEPS = {{ deps | join(' ') }}
DEPS_SCRIPTS_DIR = tools/deps
CFLAGS  += -I$(DEPS_DIR) {{ dep_cflags }}
LDFLAGS += {{ dep_ldflags }}
{% endif %}

# Profile: `make type=RELEASE` for an optimized build
ifeq ($(type), RELEASE)
	CFLAGS += -O3 -DNDEBUG
else
	SANITIZERS = -fsanitize=address,undefined
	CFLAGS  += -DDEBUG -ggdb $(SANITIZERS)
	LDFLAGS += $(SANITIZERS)
endif

# Total source file count (progress output)
TOTAL_FILES := $(words $(SRC))

.PHONY: all
all: libs $(APPS) ## Build all libraries and all apps

.PHONY: libs
libs: $(LIB_ARCH) ## Build all libraries

$(LIB_ARCH):
	@lib=$(patsubst lib%,%,$(basename $(notdir $@))); \
	echo "[INFO] Building library $$lib"; \
	$(MAKE) --no-print-directory -C $(LIBS_DIR)/$$lib static

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR) ## Compile a shared source file
	@echo "[INFO] Compiling $<"
	$(CC) $(CFLAGS) -c -o $@ $<

# Build a single app: `make <app-name>`
$(APPS): %: $(BUILD_DIR)/% ## Build app '%'

$(BUILD_DIR)/%: $(APPS_DIR)/%/main.c $(OBJ) $(LIB_ARCH) | $(BUILD_DIR)
	@echo "[INFO] Building app '$*'"
	$(CC) $(CFLAGS) -c $(APPS_DIR)/$*/main.c -o $(BUILD_DIR)/app_$*.o
	$(CC) $(OBJ) $(BUILD_DIR)/app_$*.o -o $@ $(LIB_ARCH) $(LDFLAGS)

-include $(DEP) $(patsubst %,$(BUILD_DIR)/app_%.d,$(APPS))

.PHONY: test
test: libs $(OBJ) ## Build and run the root tests
	@set -e; for t in $(wildcard $(TEST_DIR)/*.c); do \
		name=$$(basename $$t .c); \
		echo "[INFO] Building test $$name"; \
		$(CC) $(CFLAGS) -o $(BUILD_DIR)/test_$$name $$t $(OBJ) $(LIB_ARCH) $(LDFLAGS); \
		echo "[RUN] $$name"; \
		$(BUILD_DIR)/test_$$name; \
	done

{% if deps %}
.PHONY: fetch
fetch: ## Fetch all dependencies into $(DEPS_DIR)
	@set -e; for dep in $(DEPS); do \
		echo "[INFO] Fetching $$dep"; \
		bash $(DEPS_SCRIPTS_DIR)/$$dep/fetch $(DEPS_DIR); \
	done
{% endif %}

.PHONY: clean
clean: ## Remove all build files and apps
	rm -rf $(BUILD_DIR)
	@for lib in $(LIBS); do \
		$(MAKE) --no-print-directory -C $(LIBS_DIR)/$$lib clean; \
	done

.PHONY: help
help: ## Show this help message
	@echo "Available commands:"
	@grep -h -E '^[a-zA-Z0-9_.-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-25s\033[0m %s\n", $$1, $$2}'
