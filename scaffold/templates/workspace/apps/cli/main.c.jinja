#include <stdio.h>

#include "version.h"
#include "core.h"
{% if dep_cli %}
#define CLI_IMPLEMENTATION
#include "io/cli.h"
{% endif %}

int main(int argc, char** argv)
{
    (void)argc;
    (void)argv;

    if (core_init() != 0) {
        fprintf(stderr, "Failed to initialize core\n");
        return 1;
    }

    printf("[%s] app '%s' using core '%s' v%s\n",
           "cli", "{{ name }}", core_name(), VERSION_STRING);
    return 0;
}
